# Keep the build context limited to the PWA and its asset preparation script.
**
!package.json
!package-lock.json
!index.html
!vite.config.ts
!tsconfig.json
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/prepare-assets.mjs
!scripts/prepare-conversation-assets.mjs
!scripts/conversation-assets.lock.json
