{
  "name": "signemo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prune-candidate-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "assets:moonshine": "node scripts/prepare-moonshine-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run assets:verify && npm run build",
    "assets:conversation": "node scripts/prepare-conversation-assets.mjs",
    "lint": "eslint scripts --no-warn-ignored && node scripts/check-boundaries.mjs",
    "format": "prettier --write src tests scripts/*.mjs scripts/*.json *.json *.mjs *.yaml",
    "format:check": "prettier --check src tests scripts/*.mjs scripts/*.json package.json tsconfig.json vite.config.ts compose.yaml",
    "docker:up": "docker compose up -d --build",
    "docker:dev": "docker compose --profile dev up -d --build dev",
    "docker:down": "docker compose --profile dev down",
    "speech:evaluate": "node scripts/evaluate-speech.mjs",
    "research:gipformer": "node scripts/prepare-gipformer.mjs",
    "research:face-b2": "node scripts/prepare-b2.mjs",
    "research:face-comparison": "node scripts/prepare-face-comparison.mjs",
    "research:pipeline-fixtures": "node scripts/prepare-pipeline-fixtures.mjs",
    "assets:verify:candidate": "node scripts/verify-candidate-profile.mjs",
    "research:meralion": "node scripts/prepare-meralion.mjs",
    "avatar:prepare": "node scripts/create-avatar.mjs",
    "research:fusion": "node scripts/evaluate-fusion.mjs",
    "research:audio-clamping": "node scripts/evaluate-audio-clamping.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@mediapipe/tasks-vision": "1.1.0",
    "@moonshine-ai/moonshine-wasm": "0.1.5",
    "@supabase/supabase-js": "2.117.3",
    "dexie": "4.4.6",
    "lucide-react": "1.55.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
